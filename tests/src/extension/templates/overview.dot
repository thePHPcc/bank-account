strict digraph EventSystem {
  graph [labelloc="t", label="", splines=true, overlap=false, rankdir="LR"];
  node  [fontname="Segoe UI", fontsize=10];
  edge  [fontname="Segoe UI", fontsize=9, color="#555555"];

  subgraph cluster_legend {
    label="Legend";
    fontsize=10;
    style="dashed, rounded";
    color="#CCCCCC";

    legend_command_processor   [label="Command Processor", shape=box, style="filled, rounded", fillcolor="#729fcf"];
    legend_event [label="Event", shape=box, style="filled, rounded", fillcolor="#fcaf3e"];
    legend_event_processor [label="Event Processor", shape=box, style="filled, rounded", fillcolor="#e9b96e"];
    legend_read_model [label="Read Model", shape=box, style="filled, rounded", fillcolor="#8ae234"];

    legend_command_processor -> legend_event [label="emits", style=solid, color="#729fcf"];
    legend_event -> legend_command_processor [label="consumed by", style=dashed, color="#fcaf3e"];
    legend_event -> legend_event_processor [label="consumed by", style=dashed, color="#fcaf3e"];
    legend_event -> legend_read_model [label="consumed by", style=dashed, color="#fcaf3e"];
  }

  node [shape=box, style="filled, rounded", fillcolor="#729fcf"];
{{command_processor_nodes}}

  node [shape=box, style="filled, rounded", fillcolor="#fcaf3e"];
{{event_nodes}}

  node [shape=box, style="filled, rounded", fillcolor="#8ae234"];
{{projector_nodes}}

  { rank=same; {{command_processor_node_list}} }
  { rank=same; {{event_node_list}} }
  { rank=same; {{projector_node_list}} }

  edge [style=solid, color="#729fcf"];
{{emission_edges}}

  edge [style=dashed, color="#fcaf3e"];
{{consumption_edges}}
}
